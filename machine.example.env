# Copy this file to ~/.config/workstation/machine.env
# The bootstrap reads it when PROFILES is not already set.
#
# Comma-separated profile names. Files live in profiles/.
#   base    every machine
#   work    OpenShift, GitOps, and day-to-day engineering tools
#   ai      local model inference
#   gaming  Steam and related desktop tools
#   laptop  touchpad, scaling, and AC versus battery power
PROFILES=base
